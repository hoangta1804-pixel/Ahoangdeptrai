# Sao chép thành .env.local. Xem README.md và docs/BACKEND_API.md.
# npm run dev mặc định DEMO_MODE=true. npm start mặc định chế độ thật.
DEMO_MODE=false
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_PATH=data/production.sqlite
# Tạo khóa 64 ký tự hex theo README; bắt buộc cho npm start ở chế độ thật.
DATA_ENCRYPTION_KEY=
# Chỉ khởi tạo Quản trị gốc khi database trống. Không dùng SĐT mẫu khi chạy thật.
BOOTSTRAP_ADMIN_PHONE=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000
# Khi triển khai thật: PUBLIC_URL=https://ten-mien-cua-ban và ALLOWED_ORIGINS chỉ giữ origin HTTPS.
PUBLIC_URL=
ACCOUNT_LINK_DELIVERY_URL=
ACCOUNT_LINK_DELIVERY_TOKEN=
SMS_OTP_URL=
SMS_OTP_TOKEN=
PAYMENT_WEBHOOK_SECRET=
REFUND_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
CARRIER_WEBHOOK_SECRET=
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
PAYMENT_SESSION_URL=
PAYMENT_SESSION_TOKEN=
PAYMENT_CHECKOUT_ORIGINS=

# Khoá Google Maps (Geocoding API) để tra địa chỉ từ GPS. Chỉ máy chủ dùng: KHÔNG thêm tiền tố VITE_.
GOONG_API_KEY=
GOOGLE_MAPS_API_KEY=

# Client ID đăng nhập bằng Google (dạng ….apps.googleusercontent.com). Công khai, gắn vào app lúc build.
# Để trống thì Google thật chưa được bật; đăng nhập mô phỏng chỉ hoạt động trong demo.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# API_PROXY_TARGET=http://127.0.0.1:4000
