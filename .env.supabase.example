# Copy to .env.local after creating a Supabase project. Never put real secrets here.
DATABASE_PROVIDER=supabase
DEMO_MODE=false
API_PORT=4000
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# Server only: copy the Session pooler URI from the project's Connect dialog.
SUPABASE_DB_URL=
# Optional: downloaded Supabase CA certificate path if required by your connection.
SUPABASE_DB_CA_PATH=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: secret/service_role key, never prefix this variable with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Verified email used to link/bootstrap the first root account.
SUPABASE_ADMIN_EMAIL=
# Required 64-character hex encryption key. Keep it for future reads and backups.
DATA_ENCRYPTION_KEY=

# Browser-safe values: same project URL and publishable key as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional integrations for the existing phone-application and payment workflows.
SMS_OTP_URL=
SMS_OTP_TOKEN=
GOOGLE_MAPS_API_KEY=
PAYMENT_WEBHOOK_SECRET=
REFUND_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
CARRIER_WEBHOOK_SECRET=
